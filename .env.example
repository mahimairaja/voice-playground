# Public site URL used by Next metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional remote app config support from the upstream LiveKit shell.
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
AGENT_NAME=

# Optional. Override the cookbook raw URL base (e.g. for forks of
# awesome-voice-apps). Default points at the canonical repo on main.
# NEXT_PUBLIC_COOKBOOK_BASE_URL=https://raw.githubusercontent.com/mahimairaja/awesome-voice-apps/main
