# Public site URL used by Next metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Override the cookbook raw URL base (e.g. for forks of
# awesome-voice-apps). Default points at the canonical repo on main.
# NEXT_PUBLIC_COOKBOOK_BASE_URL=https://raw.githubusercontent.com/mahimairaja/awesome-voice-apps/main

# Optional. Upstash Redis (or Vercel KV) backs demo upvotes. Without these the
# upvote buttons stay hidden and everything else works unchanged. The Vercel
# Upstash integration sets these in the deployment; for local dev copy them from
# the integration's snippet. KV_REST_API_URL / KV_REST_API_TOKEN also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
