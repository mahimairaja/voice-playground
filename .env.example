# Public site URL used by Next metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional remote app config support from the upstream LiveKit shell.
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
AGENT_NAME=

# Sibling repo holding the demo manifests. The prebuild script clones this on
# Vercel and on fresh local checkouts. Clone failures fall back to reference
# seed data unless AVA_SYNC_STRICT=1.
AVA_REPO=https://github.com/mahimairaja/awesome-voice-apps.git
AVA_REF=main
AVA_SYNC_STRICT=0
